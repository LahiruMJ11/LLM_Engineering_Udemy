    "# ---------- Robust requests session ----------\n",
    "HEADERS = {\n",
    "    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/117.0.0.0 Safari/537.36\"\n",
    "}\n",
    "\n",
    "_session = requests.Session()\n",
    "_retries = Retry(\n",
    "    total=3,                # retry up to 3 times\n",
    "    backoff_factor=0.5,     # sleep 0.5s, 1s, 2s between retries\n",
    "    status_forcelist=[429, 500, 502, 503, 504],\n",
    "    allowed_methods=[\"GET\", \"HEAD\", \"OPTIONS\"]\n",
    ")\n",
    "_session.mount(\"https://\", HTTPAdapter(max_retries=_retries))\n",
    "_session.mount(\"http://\",  HTTPAdapter(max_retries=_retries))\n",
    "\n",
    "def _safe_get(url: str, timeout: float = 10.0) -> requests.Response | None:\n",
    "    try:\n",
    "        resp = _session.get(url, headers=HEADERS, timeout=timeout)\n",
    "        # Treat non-2xx as failure but without raising\n",
    "        if 200 <= resp.status_code < 300:\n",
    "            return resp\n",
    "    except requests.RequestException:\n",
    "        pass\n",
    "    return None\n",
    "\n",
    "# ---------- Website class with error handling ----------\n",
    "class Website:\n",
    "    \"\"\"\n",
    "    Represents a web page with title, cleaned text, and outgoing links.\n",
    "    Robust to timeouts, bad SSL, missing <body>, etc.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, url: str):\n",
    "        self.url = url\n",
    "        self.title = \"No title found\"\n",
    "        self.text = \"\"\n",
    "        self.links: list[str] = []\n",
    "\n",
    "        resp = _safe_get(url)\n",
    "        if not resp:\n",
    "            # Could not fetch page; keep defaults\n",
    "            return\n",
    "\n",
    "        content = resp.content\n",
    "        soup = BeautifulSoup(content, \"html.parser\")\n",
    "\n",
    "        # Title (guard against missing/empty)\n",
    "        if soup.title and soup.title.string:\n",
    "            self.title = soup.title.string.strip()\n",
    "\n",
    "        # Body text cleanup\n",
    "        body = soup.find(\"body\")\n",
    "        if body:\n",
    "            for tag in body.find_all([\"script\", \"style\", \"img\", \"input\"]):\n",
    "                tag.decompose()\n",
    "            self.text = body.get_text(separator=\"\\n\", strip=True)\n",
    "\n",
    "        # Collect absolute, unique, http(s) links only\n",
    "        out = set()\n",
    "        for a in soup.find_all(\"a\", href=True):\n",
    "            href = urljoin(self.url, a[\"href\"])\n",
    "            parsed = urlparse(href)\n",
    "            if parsed.scheme in (\"http\", \"https\"):\n",
    "                out.add(href)\n",
    "        self.links = sorted(out)\n",
    "\n",
    "    def get_contents(self) -> str:\n",
    "        return f\"Webpage Title:\\n{self.title}\\nWebpage Contents:\\n{self.text}\\n\\n\"\n"
   ]
